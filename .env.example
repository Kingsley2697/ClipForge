# ==========================================
# ClipForge AI — Environment Variables
# ==========================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (Prisma) ---
# SQLite (local dev) — default
DATABASE_URL="file:./dev.db"
# PostgreSQL (production)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/clipforge?schema=public"

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- OpenAI (Whisper Transcription) ---
OPENAI_API_KEY=sk-...

# --- Google Gemini (Viral Analysis) ---
GEMINI_API_KEY=AIza...

# --- File Storage ---
# Local: files are saved in /public/uploads & /public/outputs
UPLOAD_DIR=./public/uploads
OUTPUT_DIR=./public/outputs

# --- FFmpeg & yt-dlp Paths (optional overrides) ---
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# YTDLP_PATH=/usr/local/bin/yt-dlp

# --- Paystack Billing ---
# Use a test key locally and a live key only in production.
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# --- Promo Codes ---
# Comma-separated, case-insensitive codes that grant one month of free Pro access.
PROMO_CODES=VIPFRIEND,FREEPRO2026

# --- Worker timeouts and capacity ---
# Long-running external video processes fail clearly instead of holding jobs forever.
WORKER_CONCURRENCY=1
YTDLP_TIMEOUT_MS=900000
FFMPEG_TIMEOUT_MS=900000
