# ==========================================
# ClipForge AI — Environment Variables
# ==========================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (Prisma) ---
# SQLite (local dev) — default
DATABASE_URL="file:./dev.db"
# PostgreSQL (production)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/clipforge?schema=public"

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- OpenAI (Whisper Transcription) ---
OPENAI_API_KEY=sk-...

# --- Google Gemini (Viral Analysis) ---
GEMINI_API_KEY=AIza...

# --- File Storage ---
# Local: files are saved in /public/uploads & /public/outputs
UPLOAD_DIR=./public/uploads
OUTPUT_DIR=./public/outputs

# --- FFmpeg & yt-dlp Paths (optional overrides) ---
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# YTDLP_PATH=/usr/local/bin/yt-dlp

# --- NextAuth (optional for auth) ---
NEXTAUTH_SECRET=your_super_secret_here
NEXTAUTH_URL=http://localhost:3000
